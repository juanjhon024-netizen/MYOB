# PostgreSQL Online Connection String (Wajib diisi di Vercel & produksi; jangan gunakan Supabase jika diminta non-Supabase)
# Contoh format: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/smartguide?sslmode=require"

# Opsional: Atur ke "false" hanya jika memakai PostgreSQL lokal tanpa SSL (default otomatis SSL aktif untuk host remote)
DATABASE_SSL="true"

# PIN awal akses Mode Guru (minimal 4 karakter/angka, disimpan ke tabel smartguide_settings saat inisialisasi awal)
TEACHER_PIN="1818"

# Port server lokal (AI Studio / Node standalone)
PORT="3000"

# GEMINI_API_KEY: Required for Gemini AI API calls if AI features are enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted.
APP_URL="MY_APP_URL"
